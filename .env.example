# DataxLand – biến môi trường (spec 00 §4.1). Giá trị mẫu cho `local`.
# Không đặt bí mật thật vào file này. `.env` nằm trong .gitignore.

DX_ENV=local
DX_PUBLIC_BASE_URL=http://localhost:3000
DX_API_PUBLIC_URL=http://localhost:8000
# Email nhận cảnh báo kỹ thuật của team (spec 04 §5.3)
DX_TEAM_EMAIL=team@dataxland.local

# Postgres control plane
DATABASE_URL=postgresql+psycopg://dx:dx@localhost:5432/dx
DAGSTER_PG_URL=postgresql://dx:dx@localhost:5432/dagster

# Kho dữ liệu
GCP_PROJECT_ID=dataxland-dev
BQ_LOCATION=asia-southeast1
DUCKDB_PATH=./.local/dx.duckdb
METADATA_BUCKET=./.local/meta
HC_BUCKET=./.local/hc
SECRETS_DIR=./.secrets

# Firebase Auth (local dùng emulator)
FIREBASE_PROJECT_ID=dataxland-local
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
NEXT_PUBLIC_FIREBASE_API_KEY=local-emulator-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dataxland-local
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cube
CUBE_API_URL=http://localhost:4000
CUBE_API_SECRET=local-cube-secret-change-me
CUBEJS_DB_TYPE=duckdb

# Dịch vụ nội bộ
INTERNAL_API_TOKEN=local-internal-token-change-me
API_INTERNAL_URL=http://localhost:8000

# Telegram (spec 08)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=local-webhook-secret
TELEGRAM_TEAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=dataxland_bot
BOT_MODE=polling
BOT_PUBLIC_URL=

# Email giao dịch qua SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=DataxLand <no-reply@dataxland.local>

# Windsor.ai – chỉ để kiểm tra trạng thái, không để nạp dữ liệu
WINDSOR_API_KEY=

# Tỷ giá Vietcombank (spec 01 §6)
FX_VCB_URL=https://portal.vietcombank.com.vn/Usercontrols/TVPortal.TyGia/pXML.aspx
FX_CURRENCIES=USD

# OAuth sàn: URL công khai của API để sàn gọi callback (spec 05 §6.7)
MARKETPLACE_OAUTH_REDIRECT_BASE=http://localhost:8000

# Claude (GĐ2, spec 09)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ASK=claude-sonnet-5-5
ANTHROPIC_MODEL_AGENT=claude-sonnet-5-5
MCP_URL=http://localhost:8200/mcp
MCP_SESSION_SECRET=local-mcp-secret-change-me

# Giới hạn tần suất Telegram: số lần / giây (spec 08 §6)
TG_RATE_COMMANDS=20/600
TG_RATE_ASK_CHAT=10/3600
TG_RATE_ASK_TENANT=50/86400
